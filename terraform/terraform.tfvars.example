# Example Terraform variables file
# Copy this to terraform.tfvars and customize as needed

aws_region   = "us-east-1"
environment  = "test"
project_name = "bastion-test"

# Network Configuration
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

# Security Configuration
# WARNING: "0.0.0.0/0" allows SSH from anywhere - restrict this in production!
# Example: allowed_ssh_cidr = ["203.0.113.0/24", "198.51.100.0/24"]
allowed_ssh_cidr = ["0.0.0.0/0"]

# Instance Configuration
instance_type = "t2.micro"

# SSH Key Configuration
# Leave empty to auto-generate a key pair
# Or provide your own public key:
# ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... your-email@example.com"
ssh_public_key = ""
